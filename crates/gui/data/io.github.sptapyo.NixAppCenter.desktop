[Desktop Entry]
Type=Application
Name=Nix App Center
GenericName=Software Store
Keywords=nix;nixpkgs;package;install;store;software;
GenericName[fr]=Logithèque
Comment=Declarative app store for Nix
Comment[fr]=App store déclaratif pour Nix
Exec=nix-app-center %U
Icon=io.github.sptapyo.NixAppCenter
Terminal=false
Categories=System;PackageManager;GTK;
Keywords[fr]=nix;nixpkgs;paquet;installer;logithèque;
StartupNotify=true
MimeType=x-scheme-handler/nixpkg;application/vnd.debian.binary-package;application/x-rpm;application/x-redhat-package-manager;application/vnd.appimage;application/x-iso9660-appimage;
