[Desktop Entry]
Type=Application
Name=Nix Software
GenericName=Software Store
Keywords=nix;nixpkgs;package;install;store;software;
GenericName[fr]=Logithèque
Comment=Declarative app store for Nix
Comment[fr]=App store déclaratif pour Nix
Exec=nix-software %U
Icon=io.github.sptapyo.NixSoftware
Terminal=false
Categories=System;PackageManager;GTK;
Keywords[fr]=nix;nixpkgs;paquet;installer;logithèque;
StartupNotify=true
MimeType=x-scheme-handler/nixpkg;
