#: crates/core/src/oars.rs:169
msgid "No advertising of any kind"
msgstr "किसी भी प्रकार का विज्ञापन नहीं"

#: crates/core/src/oars.rs:170
msgid "Product placement"
msgstr "उत्पाद प्लेसमेंट"

#: crates/core/src/oars.rs:172
msgid "Explicit references to specific brands or trademarked products"
msgstr "विशिष्ट ब्रांडों या ट्रेडमार्क वाले उत्पादों के स्पष्ट उल्लेख"

#: crates/core/src/oars.rs:175
msgid "Users are encouraged to purchase specific real-world items"
msgstr "उपयोगकर्ताओं को विशिष्ट वास्तविक वस्तुएँ खरीदने के लिए प्रोत्साहित किया जाता है"

#: crates/core/src/oars.rs:182
msgid "No gambling of any kind"
msgstr "किसी भी प्रकार का जुआ नहीं"

#: crates/core/src/oars.rs:183
msgid "Gambling on random events using tokens or credits"
msgstr "टोकन या क्रेडिट से यादृच्छिक घटनाओं पर जुआ"

#: crates/core/src/oars.rs:184
msgid "Gambling using \"play\" money"
